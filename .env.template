# AWS Bedrock (primary LLM provider)
# Check the model IDs available to your account before changing this value.
BEDROCK_MODEL_ID=us.anthropic.claude-sonnet-4-6
BEDROCK_REGION=us-west-2

# Optional: set this when you use a named AWS CLI profile.
# AWS_PROFILE=default

# Optional: OpenAI fallback.
# OPENAI_API_KEY=

# ---- Optional: Google 对照基线 ----
# 每次跑 agent 后额外记一份 Google 检索结果，用来打分"我们有没有比自己上网搜更强"。
# 它**不作为 agent 的输入**（否则模型会抄 Google 的数字，基线失去独立性）。
# 不配这两个值就静默跳过，主流程不受影响。
#
# 取值步骤:
#   1. Google Cloud 启用 "Custom Search API" 并创建 API key → GOOGLE_API_KEY
#   2. https://programmablesearchengine.google.com/ 新建搜索引擎，
#      打开"搜索整个网络"，复制搜索引擎 ID(cx) → GOOGLE_CSE_ID
# 免费额度 100 次/天；每次 agent 运行最多消耗 2 次（原样 query + 公平 query）。
# GOOGLE_API_KEY=
# GOOGLE_CSE_ID=
# BENCHMARK_PATH=benchmarks/google_compare.jsonl
# BENCHMARK_TOP_N=10
# 公司代理(Netskope 等)对 googleapis.com 做 TLS 中间人时，需要它的 CA bundle。
# 默认沿用 SSL_CERT_FILE；仅在需要覆盖时设置下面这项。
# BENCHMARK_CA_BUNDLE=/etc/ssl/netskope/<org>/ca-bundle.pem
